# Required
PORT=8751
DATABASE_URL=ic_database/ic_papers.sqlite
JWT_SECRET=replace-with-a-long-random-string
APP_NAME=SiliconScope

# Optional: CORS origins for frontend dev servers
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# Optional: require login for admin pages (0 = no password, 1 = require login)
IC_SEEKER_REQUIRE_LOGIN=0

# Optional: admin password when IC_SEEKER_REQUIRE_LOGIN=1
ADMIN_PASSWORD=change-me-now

# Optional paths for data ingestion and local PDF workflow
IC_SEEKER_CSV=ic_database/ic_chipseeker.csv
IC_SEEKER_PDF_INBOX=ic_database/pdf_inbox

# Optional metadata/API integrations.
CROSSREF_MAILTO=
IEEE_API_KEY=
AMINER_API_KEY=
# Optional: use a pre-signed AMiner Authorization JWT instead of a signing secret.
AMINER_AUTH_TOKEN=
OPENAI_API_KEY=
