# Required
PORT=8751
DATABASE_URL=ic_database/ic_papers.sqlite
JWT_SECRET=replace-with-a-long-random-string
APP_NAME=SiliconScope
DEPLOYMENT_MODE=local
TRUST_PROXY=0
PUBLIC_SITE_URL=http://localhost:5173
ADMIN_SITE_URL=http://localhost:5176
API_BASE_URL=http://127.0.0.1:8751

# Vite build-time API origin. Leave blank for same-origin/local proxy.
VITE_API_BASE_URL=
VITE_PUBLIC_SITE_URL=http://localhost:5173
VITE_ADMIN_SITE_URL=http://localhost:5176

# Optional: CORS origins for frontend dev servers
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5176,http://127.0.0.1:5176,https://admin.example.com

# Optional: require login for admin pages (0 = no password, 1 = require login)
IC_SEEKER_REQUIRE_LOGIN=0

# Local-only admin bypass for development. Do not enable this on a public server.
IC_SEEKER_LOCAL_ADMIN=0

# Optional: admin password when IC_SEEKER_REQUIRE_LOGIN=1
ADMIN_PASSWORD=change-me-now

# Optional paths for data ingestion and local PDF workflow
IC_SEEKER_CSV=ic_database/ic_chipseeker.csv
IC_SEEKER_PDF_INBOX=ic_database/pdf_inbox
BACKUP_DIR=backups

# Optional metadata/API integrations.
CROSSREF_MAILTO=
IEEE_API_KEY=
AMINER_API_KEY=
# Optional: use a pre-signed AMiner Authorization JWT instead of a signing secret.
AMINER_AUTH_TOKEN=
OPENAI_API_KEY=

# Optional commercial architecture services. These are inert until adapters are implemented.
# Start local dependencies with:
# docker compose -f docker-compose.infra.yml up -d
POSTGRES_URL=postgresql://siliconscope:siliconscope_dev_password@127.0.0.1:5432/siliconscope
REDIS_URL=redis://127.0.0.1:6379
SEARCH_ENGINE=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=siliconscope_dev_master_key

# S3-compatible object storage, for example Cloudflare R2, MinIO, AWS S3, or OSS.
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=siliconscope-assets
OBJECT_STORAGE_ACCESS_KEY_ID=siliconscope
OBJECT_STORAGE_SECRET_ACCESS_KEY=siliconscope_dev_password
OBJECT_STORAGE_PUBLIC_BASE_URL=

# Async jobs and realtime layer.
QUEUE_BACKEND=redis
REALTIME_ENABLED=0
SOCKET_IO_PATH=/socket.io

# SaaS integrations.
PAYMENT_PROVIDER=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PADDLE_API_KEY=
EMAIL_PROVIDER=disabled
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Observability.
SENTRY_DSN=
PROMETHEUS_ENABLED=0
