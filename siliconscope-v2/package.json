{
  "name": "siliconscope-v2",
  "version": "0.2.0",
  "private": true,
  "description": "SiliconScope v2 frontend/backend separated IC research platform.",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend",
    "frontend-admin"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "build": "npm --workspace siliconscope-v2-backend run build && npm --workspace siliconscope-v2-frontend run build && npm --workspace siliconscope-v2-admin run build",
    "build:backend": "npm --workspace siliconscope-v2-backend run build",
    "build:frontend": "npm --workspace siliconscope-v2-frontend run build",
    "build:admin": "npm --workspace siliconscope-v2-admin run build",
    "start": "npm --workspace siliconscope-v2-backend run start",
    "test": "npm --workspace siliconscope-v2-backend run test",
    "env:check": "node scripts/check-env-example.mjs",
    "db:build-from-csv": "npm --workspace siliconscope-v2-backend run db:build-from-csv --",
    "companies:seed": "npm --workspace siliconscope-v2-backend run companies:seed",
    "companies:market-refresh": "npm --workspace siliconscope-v2-backend run companies:market-refresh --",
    "backup:create": "npm --workspace siliconscope-v2-backend run backup:create --",
    "backup:restore": "npm --workspace siliconscope-v2-backend run backup:restore --",
    "backup:smoke": "node scripts/smoke-backup-restore.mjs",
    "deploy:init": "node scripts/init-production-domain.mjs",
    "deploy:check": "node scripts/check-production-env.mjs",
    "deploy:doctor": "node scripts/deploy-doctor.mjs",
    "dev:windows": "powershell -ExecutionPolicy Bypass -File ./start-dev.ps1",
    "dev:backend": "npm --workspace siliconscope-v2-backend run dev",
    "dev:frontend": "npm --workspace siliconscope-v2-frontend run dev -- --host 127.0.0.1 --port 5173",
    "dev:admin": "npm --workspace siliconscope-v2-admin run dev",
    "pdf:scan": "npm --workspace siliconscope-v2-backend run pdf:scan --",
    "identity:candidates": "npm --workspace siliconscope-v2-backend run identity:candidates --",
    "foundation:refresh": "npm --workspace siliconscope-v2-backend run foundation:refresh --",
    "dedupe:scan": "npm --workspace siliconscope-v2-backend run dedupe:scan --",
    "search:rebuild": "npm --workspace siliconscope-v2-backend run foundation:refresh -- --search-only",
    "search:smoke": "npm --workspace siliconscope-v2-backend run search:smoke --"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  }
}
