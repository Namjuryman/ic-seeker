# Copy to .env on the production server and replace every example value.

NODE_ENV=production
HOST=0.0.0.0
PORT=8750
APP_NAME=SiliconScope

DATABASE_URL=ic_database/ic_papers.sqlite
JWT_SECRET=replace-with-at-least-32-random-characters

# Public site + admin site. Do not use "*" in production.
FRONTEND_ORIGINS=https://siliconscope.com,https://www.siliconscope.com,https://admin.siliconscope.com

# Public deployment must require login for private/admin operations.
IC_SEEKER_REQUIRE_LOGIN=1
IC_SEEKER_LOCAL_ADMIN=0
ADMIN_PASSWORD=replace-with-a-long-random-admin-password

IC_SEEKER_CSV=ic_database/ic_chipseeker.csv
IC_SEEKER_PDF_INBOX=ic_database/pdf_inbox

CROSSREF_MAILTO=
IEEE_API_KEY=
AMINER_API_KEY=
AMINER_AUTH_TOKEN=
OPENAI_API_KEY=

# Future production services. Keep disabled until adapters are wired.
POSTGRES_URL=
REDIS_URL=
SEARCH_ENGINE=sqlite
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=siliconscope-assets
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=

QUEUE_BACKEND=disabled
REALTIME_ENABLED=0
PAYMENT_PROVIDER=disabled
EMAIL_PROVIDER=disabled
SENTRY_DSN=
PROMETHEUS_ENABLED=0
