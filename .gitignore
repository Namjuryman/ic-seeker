# Runtime logs
*.log
*.err.log
.env

# Separate public demo working copy; it is published to Namjuryman/SiliconScope.
SiliconScope-public/

# Temporary / validation database builds
ic_database_checks/
ic_database/*backup*.sqlite
ic_database/*.sqlite-journal
ic_database/*.sqlite-shm
ic_database/*.sqlite-wal
siliconscope-v2/ic_database/*.sqlite-shm
siliconscope-v2/ic_database/*.sqlite-wal

# Local PDF storage. Keep the folders, not the PDFs.
ic_database/pdfs/*
!ic_database/pdfs/.gitkeep
ic_database/pdf_inbox/*
!ic_database/pdf_inbox/.gitkeep

# External references and previous Zotero workspace
references/
zotero-downloads/
scripts/install-zotero-plugins.ps1
scripts/setup-zotero.ps1

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Frontend/backend generated artifacts
node_modules/
dist/
*.tsbuildinfo
siliconscope-v2/**/node_modules/
siliconscope-v2/**/dist/
siliconscope-v2/**/*.tsbuildinfo
siliconscope-v2/ic_database/*backup*.sqlite
ic_seeker/scripts/*log*.txt
*.tmp
